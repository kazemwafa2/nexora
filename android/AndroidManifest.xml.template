<?xml version="1.0" encoding="utf-8"?>
<!-- The applicationId is NOT final (decision E1/E2 pending); tools/build_apk_termux.sh sets it with
     the aapt2 option rename-manifest-package. The script also replaces the version and target-SDK
     placeholders below and refuses to build if any placeholder is left. (Never put two hyphens in a
     comment: XML forbids them.) -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="com.nexora.desktop"
    android:versionCode="1"
    android:versionName="@VERSION@">

    <uses-sdk android:minSdkVersion="24" android:targetSdkVersion="@TARGET_SDK@" />

    <!-- No dangerous permissions: the first build only touches app-private storage. -->

    <application
        android:label="@string/app_name"
        android:icon="@mipmap/ic_launcher"
        android:supportsRtl="true"
        android:allowBackup="false"
        android:largeHeap="false">
        <activity
            android:name="com.nexora.desktop.MainActivity"
            android:exported="true"
            android:theme="@android:style/Theme.Material.NoActionBar.Fullscreen"
            android:configChanges="orientation|screenSize|smallestScreenSize|screenLayout|keyboard|keyboardHidden|uiMode|density|layoutDirection|navigation"
            android:windowSoftInputMode="adjustPan">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>
</manifest>
